# --- Général ---
NODE_ENV=development
PORT=4000
# MongoDB Atlas : Database > Connect > Drivers
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/patisserie
# URL(s) du frontend autorisées (séparées par des virgules)
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# --- Sessions ---
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# 'lax' si frontend et API sont sur le même domaine (www.x.ca / api.x.ca), sinon 'none'
COOKIE_SAMESITE=lax

# --- Stripe (vide = paiements simulés) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Twilio SMS (vide = SMS affichés dans la console) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Resend courriels (vide = courriels affichés dans la console) ---
RESEND_API_KEY=
EMAIL_FROM=Pâtisserie <commandes@votre-domaine.ca>

# --- Cloudinary images ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
